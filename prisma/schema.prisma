generator client {
	provider = "prisma-client"
	output   = "../app/_generated/prisma"
}

datasource db {
	provider = "postgresql"
}

enum Role {
	admin
	editor
}

model User {
	id        Int    @id @default(autoincrement())
	email     String @unique
	password  String
	firstName String
	lastName  String
	role      Role   @default(editor)
	posts     Post[]
}

model SiteSetting {
	id    Int    @id @default(autoincrement())
	key   String @unique
	value String
}

model Post {
	id        Int       @id @default(autoincrement())
	title     String
	body      String
	authorId  Int
	author    User      @relation(fields: [authorId], references: [id])
	publishAt DateTime?
	createdAt DateTime  @default(now())
	updatedAt DateTime  @updatedAt

	@@index([publishAt])
}
